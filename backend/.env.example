APP_NAME=SecOps Assistant
ENVIRONMENT=development

# Must match the postgres service in docker-compose.yml when running via Docker
DATABASE_URL=postgresql+asyncpg://secops:secops@db:5432/secops

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
